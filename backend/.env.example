# PostgreSQL Connection Settings
# ─────────────────────────────────────────────────────────────────────────────
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=web_scraper
PG_USER=postgres
PG_PASSWORD=postgres

# Cloud PostgreSQL (Neon / Supabase / Render etc.) — uncomment if using cloud
# PG_DSN=postgresql://user:password@host/dbname?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# Secret key for JWT tokens
SECRET_KEY=change-this-to-a-random-secret-key-in-production
